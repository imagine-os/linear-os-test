{
  "name": "paperos-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "PaperOS build-loop orchestrator: Linear workspace-as-code, the claim/promote loop, and agent session plumbing.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "linear:configure": "tsx ops/linear/configure-workspace.ts",
    "playbook:dryrun": "tsx scripts/playbook-dryrun.ts",
    "footer:validate": "tsx scripts/playbook-dryrun.ts --validate",
    "test:coverage": "vitest run --coverage",
    "contract:audit": "tsx src/cli/contract-audit.ts",
    "contract:webhook": "tsx src/webhook/server.ts",
    "orchestrator:status": "tsx src/cli/status.ts",
    "orchestrator:loop": "tsx src/cli/loop.ts",
    "justin:queue": "tsx src/cli/justin-queue.ts"
  },
  "dependencies": {
    "@linear/sdk": "^39.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
